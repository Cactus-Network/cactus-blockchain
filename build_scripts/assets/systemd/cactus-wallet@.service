[Unit]
Description=Cactus Wallet Service for %i
Requires=cactus-daemon@%i.service
After=cactus-daemon@%i.service

[Service]
Type=simple
Environment=CACTUS_ROOT=/home/%i/.cactus/mainnet
ExecStart=/opt/cactus/start_wallet
ExecStartPost=/bin/bash -c '(while ! /opt/cactus/cactus rpc wallet get_version 2>/dev/null; do echo "Waiting for the wallet to listen on port 12256..."; sleep 1; done); sleep 1'
User=%i
Group=%i
LimitNOFILE=1048576
LimitNPROC=1048576

[Install]
WantedBy=multi-user.target
